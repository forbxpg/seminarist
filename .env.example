# Copy to .env and fill in. Never commit .env: it holds the bot token and passwords.

# Telegram: the token from @BotFather and the Telegram user ids of the teachers.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=

# PostgreSQL. The bot reaches it inside the compose network as `db`.
POSTGRES_USER=seminarist
POSTGRES_PASSWORD=
POSTGRES_DB=seminarist
DATABASE_URL=postgresql+asyncpg://seminarist:CHANGE_ME@db:5432/seminarist

# Redis: dialog state and the task queue. The same password as REDIS_PASSWORD.
REDIS_HOST=redis
REDIS_PASSWORD=

# Where homework files, seminar PDFs, exports and backups are kept (inside the
# containers; compose binds it to ./data on the host).
STORAGE_DATA_DIR=/data
# Where backups go; point it at a folder that is synced off this machine.
STORAGE_BACKUP_DIR=/data/backups
# STORAGE_BDZ_MAX_PAGES=60
